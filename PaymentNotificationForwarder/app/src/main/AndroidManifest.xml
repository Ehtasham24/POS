<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Dangerous permission (API 23+) — requested at runtime by MainActivity, not just
         declared here. Play-Store-restricted to default SMS/Assistant apps, but that
         restriction only applies to apps distributed via the Play Store; irrelevant here
         since this app is only ever sideloaded onto a dedicated shop phone. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Android 11+ (API 30+) "package visibility": apps can no longer enumerate other
         installed apps by default — queryIntentActivities silently returns only a small
         implicitly-visible set otherwise. This <queries> block is Google's own documented
         fix for exactly this "build an app picker" case (rather than the much more
         restricted QUERY_ALL_PACKAGES permission), and is what MainActivity.loadInstalledApps()
         needs to actually see JazzCash/Easypaisa/bank/Gmail in the "Apps to Monitor" list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- usesCleartextTraffic: apps targeting API 28+ block plain-HTTP requests by default.
         The "POS Server" field in MainActivity is deliberately plain HTTP (see Server.js's
         own comment on why port 4001 exists) — this app never calls anywhere else, so a
         blanket allow here is the pragmatic fix rather than a per-host network-security-
         config, since the LAN IP typed into that field can change between shops/networks. -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.PaymentForwarder"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bound by the OS once the user grants Notification Access (MainActivity's
             "Grant Notification Access" button deep-links to that system settings screen)
             — this is what lets onNotificationPosted see other apps' (JazzCash/bank)
             notification text at all. -->
        <service
            android:name=".NotificationForwarderService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- SMS_RECEIVED_ACTION is one of the implicit broadcasts still allowed to a
             manifest-declared receiver under Android 8+'s background-execution limits
             (it's on the OS's own exemption list), so no runtime dynamic-registration
             trick is needed here the way it would be for most other implicit broadcasts. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
